pipeline {
    agent any

    stages {

        stage('Clone Code') {
            steps {
                echo 'Cloning source code from GitHub'
                git branch: 'main',
                    url: 'https://github.com/navyaarun/devops-cicd-demo.git'
            }
        }

        stage('Run Application') {
            steps {
                echo 'Running Python application'
                bat 'python app.py'
            }
        }
    }
}
